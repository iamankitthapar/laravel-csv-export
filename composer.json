{
    "name": "iamankitthapar/laravel-csv-export",
    "description": "A simple Laravel package for exporting arrays, collections, and Eloquent results to CSV files.",
    "keywords": [
        "laravel",
        "csv",
        "export",
        "download",
        "composer-package"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mr. Ankit Thapar"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "IamAnkitThapar\\LaravelCsvExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IamAnkitThapar\\LaravelCsvExport\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IamAnkitThapar\\LaravelCsvExport\\CsvExportServiceProvider"
            ],
            "aliases": {
                "CsvExport": "IamAnkitThapar\\LaravelCsvExport\\Facades\\CsvExport"
            }
        }
    },
    "scripts": {
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
